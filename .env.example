# ===== AI 服务（跨机器，172.16.199.206 上的 SGLang）=====
SGLANG_URL=http://172.16.199.206:30000
QWEN_MODEL_NAME=qwen3-vl-30b-fp8
SGLANG_API_KEY=sk-qwen3vl-2026-local-001
# 谱书内容 RAG：embedding（向量化）/ rerank（精排）服务地址与模型
# 若 206 上模型名被改动，系统会自动从 /v1/models 读取首个模型，可留空使用默认
EMBEDDING_URL=http://172.16.199.206:30010
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0.gguf
RERANK_URL=http://172.16.199.206:30011
RERANK_MODEL=qwen3-reranker-0.6b-q8_0.gguf
EMBEDDING_API_KEY=
VLM_TIMEOUT=300
# 单页识别「总」超时（秒）：硬限一页从开始到结束的总时长（含重试）。
# VLM_TIMEOUT 只是单次 HTTP read 超时，206 慢速滴答返回/挂起时会不断重置计时、
# 单页可能卡远超 VLM_TIMEOUT 甚至挂死；逐页是滑动窗口（并发 1 时一页卡=整本卡）。
# 必须 > 2 × VLM_TIMEOUT（2 次尝试 + 重试间隔 ≈ 606s），否则第二次尝试还没跑完就被硬超时砍掉。
# 硬超时只作最后保险：顽固页最多卡 N 秒即判失败跳过、其余页继续。
VLM_PAGE_TIMEOUT=660
# ===== 审核端重识别（「重新识别本页」/「批量重识别失效页」/整卷重扫）=====
# 不走导入流水线的 VLM_PAGE_TIMEOUT：主动重试放宽单页硬超时，且整页失败后自动
# 「横向切块」兜底（每块视觉 token 少，不易死循环）。前端对本接口已单独放宽超时。
REDO_PAGE_TIMEOUT=300
REDO_TILED=true
REDO_TILED_STRIPS=3
# 常规分块全部失败时的「加密分块」二次兜底带数（0 = 不重试）：块更小更不易死循环，
# 代价是竖排长段落被切得更碎，故仅在常规分块全败时才用。
REDO_TILED_RETRY_STRIPS=6
REDO_TILED_OVERLAP=0.08
REDO_TILED_MAX_ENTRIES=24
# 导入流水线：逐页识别失败时自动再走一次「审核端重识别」兜底（更长硬超时 → 仍失败则横向分块）。
# 默认开：顽固页分块后大多能出内容，代价只是个别页多等几分钟，换「新任务几乎零失效页」。
IMPORT_REDO_FALLBACK=true
# 世系页「结果存疑才补跑」：首轮判定为世系页且存疑（page_notes 疑点 / 人名低置信 <0.6 /
# 正文□≥2）→ 做一轮分块放大补漏复查，补入人名标低置信待人工复核；无疑点世系页直接返回
# （后面有人工审核把关）。成本：仅疑点世系页约额外 3 块 VLM。功德名单/其它页不复查。
VISION_AUTO_VERIFY_SHI=true

# ===== 扫描件处理参数 =====
# 页面长边上限：2400 大图让 VLM 视觉 token 暴涨（透印噪声页实测 334s，远超
# VLM_PAGE_TIMEOUT=180 被误判失败页）；1600 后单页视觉 token 约减半，同页实测
# 压回正常区间。小字密集页若识别漏读可谨慎上调。
MAX_IMAGE_LONG_EDGE=1600
PREPROCESS_DESKEW=true
# 古籍透印/噪声页建议开：抑制背景噪声 → 减小处理图体积，避免 VLM 把噪声当字
# 陷入「同一对象无限重复」死循环（实测该场景输出 40605 字符、白占 206 槽）
PREPROCESS_DENOISE=true
PREPROCESS_ENHANCE=true
PREPROCESS_BINARIZE=false
# PDF/TIF 转图（converting）并行线程数（CPU 密集）：代码默认 4；12 核机器建议设 8 接近打满
CONVERT_CONCURRENCY=8

# ===== AI 并发（206 GPU 服务：max_running_requests=4，各并发数勿超过它）=====

# ① AI 识别（逐页提取，第一段"读字"）并发数：同时让 206 识别几页
MAX_CONCURRENT_VISION_CALLS=3

# ② AI 整理（卷级整理，第二段"归并人物/推断关系"）并发数：同时整理几个文本块
CONSOLIDATE_MAX_CONCURRENCY=3
# 卷内 AI 全局消歧 pass（整理收尾）：整卷人物 ≥ 该值才跑；低于置信阈值的建议不自动合并
# CONSOLIDATE_DISAMBIG_MIN_PERSONS=200
# CONSOLIDATE_DISAMBIG_BATCH_CHARS=6000
# CONSOLIDATE_DISAMBIG_MIN_CONF=0.9

# 同时导入任务数：1 = 一次只识别一本书（推荐）；>1 = 多本书并行，会共享上面两个并发数
MAX_CONCURRENT_IMPORT_TASKS=1

